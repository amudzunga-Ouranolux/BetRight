# Copy to .env for local runs. Without a key, use the offline seed:
#   python -m app.data.seed && python -m app.jobs.predict_batch

# Database. Defaults to a local SQLite file if unset.
# Postgres (docker): postgresql+psycopg://betright:betright@localhost:5432/betright
DATABASE_URL=sqlite+pysqlite:///./dev.db

# Data provider: 'espn' (free, no key, live World Cup) or 'football-data' (needs key).
PROVIDER=espn

# football-data.org API key (only needed when PROVIDER=football-data):
# https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

PORT=8001

# Squad-strength enrichment (API-Football). Free tier = seasons 2022-2024, 100 req/day.
# Keys come from env — never commit them (the root .gitignore excludes APIKeys/.env).
API_FOOTBALL_KEY=
SPORTMONKS_KEY=
SQUAD_SEASON=2022
API_FOOTBALL_DAILY_CAP=90
