# Copy to .env for local runs. Without a key, use the offline seed:
#   python -m app.data.seed && python -m app.jobs.predict_batch

# Database. Defaults to a local SQLite file if unset.
# Postgres (docker): postgresql+psycopg://betright:betright@localhost:5432/betright
DATABASE_URL=sqlite+pysqlite:///./dev.db

# football-data.org API key (free tier): https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

PORT=8001
