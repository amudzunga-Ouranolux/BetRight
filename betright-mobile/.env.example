# Copy to .env. Expo inlines EXPO_PUBLIC_* vars at build time.

# Use local sample data (default). Set to "false" to call the live BFF.
EXPO_PUBLIC_USE_MOCK=true

# Base URL of the .NET BFF when EXPO_PUBLIC_USE_MOCK=false.
# Android emulator: http://10.0.2.2:8080 ; iOS sim / web: http://localhost:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
